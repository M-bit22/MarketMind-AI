{
  "$defs": {
    "CoverageItem": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "pattern": "^Q[1-9][0-9]*$",
          "title": "Question Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_addressed"
          ],
          "title": "Status",
          "type": "string"
        },
        "notes": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "status",
        "notes"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "QualityControl": {
      "additionalProperties": false,
      "properties": {
        "unsupported_claims": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Unsupported Claims",
          "type": "array"
        },
        "contradictions": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Contradictions",
          "type": "array"
        },
        "coverage_gaps": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Coverage Gaps",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "unsupported_claims",
        "contradictions",
        "coverage_gaps",
        "limitations"
      ],
      "title": "QualityControl",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^F[1-9][0-9]*$",
          "title": "Finding Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "claim": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Claim",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "fact",
            "inference",
            "recommendation",
            "uncertainty"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "finding_id",
        "title",
        "claim",
        "claim_type",
        "evidence_ids",
        "confidence"
      ],
      "title": "ReportFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "research_topic": {
      "maxLength": 300,
      "minLength": 5,
      "title": "Research Topic",
      "type": "string"
    },
    "executive_summary": {
      "maxLength": 5000,
      "minLength": 20,
      "title": "Executive Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReportFinding"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "quality_control": {
      "$ref": "#/$defs/QualityControl"
    },
    "overall_conclusion": {
      "maxLength": 3000,
      "minLength": 10,
      "title": "Overall Conclusion",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "research_topic",
    "executive_summary",
    "findings",
    "coverage",
    "quality_control",
    "overall_conclusion",
    "limitations"
  ],
  "title": "FinalResearchReport",
  "type": "object"
}